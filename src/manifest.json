{
  "manifest_version": 3,
  "name": "Parcia Plugin",
  "version": "0.1.0",
  "description": "Escanea creadores de TikTok e Instagram con tu cuenta de Parcia.",
  "key": "",
  "permissions": ["storage", "sidePanel", "scripting"],
  "host_permissions": ["https://www.tiktok.com/*", "https://www.instagram.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.tiktok.com/*"],
      "js": ["content/tiktok-interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["auth/callback.html"],
      "matches": ["http://127.0.0.1:8000/*", "http://localhost:8000/*"]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Abrir Parcia Plugin",
    "default_icon": "icons/icon.png"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "icons": {
    "128": "icons/icon.png"
  }
}
